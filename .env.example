# ── 확장 프로그램 / 웹 빌드 (Vite) ─────────────────────────────
# 모두 선택 사항입니다. 비워 두면 괄호 안의 기본값을 씁니다.

# 리포트의 LLM 문장을 만들어 주는 Vercel 함수 주소 (기본: https://handofff.vercel.app/api/insights)
VITE_INSIGHTS_URL=

# 공유 링크가 열리는 웹 주소 (기본: https://handofff.vercel.app)
VITE_WEB_URL=

# Chrome 웹 스토어 등록 후 확장 프로그램 페이지 주소. 비워 두면 GitHub 링크와 수동 설치 안내가 표시된다.
VITE_STORE_URL=

# ── Vercel 함수 (api/insights.ts) ──────────────────────────────
# 아래 값은 이 파일이 아니라 Vercel 프로젝트의 Environment Variables 에 넣는다. 저장소에 올리지 않는다.
#   OPENAI_API_KEY   (필수)
#   OPENAI_MODEL     (선택, 기본 gpt-6-luna)
#   ALLOWED_ORIGINS  (선택, 출시 후 권장: chrome-extension://<확장 ID>,https://handofff.vercel.app)
